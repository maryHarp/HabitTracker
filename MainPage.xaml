<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.MainPage">

    <Grid RowDefinitions="5*, *">
        
        <Border Grid.Row="0" Stroke="Blue" Margin="300, 20">
            <FlexLayout Direction="Row" JustifyContent="SpaceEvenly" >
                <Label Text="{Binding Source={x:Reference BasicTextEntry}, Path=Text, Mode=OneWay}" WidthRequest="350" FontSize="28"/>
            </FlexLayout>
        </Border>
        
        <Border Grid.Row="1" Stroke="Red" Margin="5, 10">
            <FlexLayout Direction="Row" JustifyContent="SpaceEvenly">
                <Entry x:Name="BasicTextEntry" WidthRequest="350" FontSize="28" BackgroundColor="Grey"/>
                <Button Text="Add Habit" FontSize="28" Pressed="AddHabit_Pressed"/>
            </FlexLayout>
        </Border>

    </Grid>

</ContentPage>
