<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HabitTracker.MainPage">

    <Grid ColumnDefinitions="*" Margin="10">

        <!-- Left Side: Input Controls -->
        <Border Grid.Column="0" Margin="5" Padding="425, 50">
            <FlexLayout Direction="Column" JustifyContent="SpaceEvenly" AlignContent="Stretch">


                <Label  x:Name="Prompt"
                        WidthRequest="350" 
                        FontSize="22" >Name Your New Habit:</Label>


                <!-- Text Entry Control -->
                <Entry x:Name="BasicTextEntry" 
                   Placeholder="Type something..." 
                   WidthRequest="350" 
                   FontSize="22" />

                <!-- Text Entry Value View -->
                <Label  Text="{Binding Source={x:Reference BasicTextEntry}, Path=Text, Mode=OneWay}" 
                   WidthRequest="350" 
                   FontSize="22" />
                

                <Button x:Name="AddhabitButton"
                        Text ="Add habit"
                        Clicked="AddhabitButton_Clicked"/>
                        


            </FlexLayout>
        </Border>
        


    </Grid>

</ContentPage>
