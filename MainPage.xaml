<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HabitTracker.MainPage">

    <Grid RowDefinitions="5*, *">

        <Border Grid.Row="0" Margin="300, 20">
            <FlexLayout x:Name="Habits" Direction="Column" />
        </Border>

        <FlexLayout Grid.Row="1" Direction="Row" JustifyContent="SpaceEvenly">
            <Entry x:Name="NameEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Entry x:Name="DescriptionEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Entry x:Name="FrequencyEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Button Text="Add Habit" FontSize="28" Pressed="AddHabit_Pressed"/>
        </FlexLayout>

    </Grid>

</ContentPage>