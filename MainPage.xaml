<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HabitTracker.MainPage">

    <Grid RowDefinitions="5*, *">

        <Border Grid.Row="0" Margin="300, 20">
            <FlexLayout x:Name="Habits" Direction="Column" />
        </Border>

        <FlexLayout Grid.Row="1" Direction="Row" JustifyContent="SpaceEvenly">
            <Entry x:Name="NameEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Entry x:Name="DescriptionEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Entry x:Name="FrequencyEntry" WidthRequest="350" FontSize="28" BackgroundColor="Black"/>
            <Button Text="Add Habit" FontSize="28" Pressed="AddHabit_Pressed"/>
        </FlexLayout>
    <Grid ColumnDefinitions="*,*" Margin="10">

        <!-- Left Side: Input Controls -->
        <Border Grid.Column="0" Margin="5" Padding="10">
            <FlexLayout Direction="Column" JustifyContent="SpaceEvenly" AlignContent="Stretch">


                <Label  x:Name="Prompt"
                        WidthRequest="350" 
                        FontSize="22"
                        Margin="20">Name Your New Habit:</Label>


                <!-- Text Entry Control -->
                <Entry x:Name="BasicTextEntry" 
                   Placeholder="Type something..." 
                   WidthRequest="350" 
                   FontSize="22"
                   Margin="80, 20"/>

                


                <Button x:Name="AddhabitButton"
                        Text ="Add habit"
                        Clicked="AddhabitButton_Clicked"
                        Margin="20"/>



            </FlexLayout>
        </Border>
        <Border Grid.Column="1" Margin="5" Padding="10">

            <!-- Right Side: View Elements (Reflecting Values via Data Binding) -->
            <FlexLayout Grid.Column="1" 
            Direction="Column" 
            JustifyContent="SpaceEvenly" 
            Padding="10">

               

                <!-- Text Entry Value View -->
                <Label Text="{Binding Source={x:Reference BasicTextEntry}, Path=Text, Mode=OneWay}" 
           WidthRequest="350" 
           FontSize="22" />

                

            </FlexLayout>
        </Border>



    </Grid>

</ContentPage>