<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="HabitTracker.MainPage">

    <Grid RowDefinitions="5*, *" Margin="10">
        <Border Grid.Row="0" Margin="30, 20">
            <FlexLayout x:Name="Habits" Direction="Column" Wrap="Wrap">
                <Label 
                    x:Name="EmptyMessage" 
                    Text="You don't have any habits :(&#10;Go ahead and create a new one!"
                    TextColor="Gray"
                    FontSize="30"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="Center"
                    />
            </FlexLayout>
        </Border>

        <FlexLayout Grid.Row="1" Direction="Row" JustifyContent="SpaceEvenly">
            <Entry x:Name="NameEntry" Placeholder="Enter Name" WidthRequest="350" FontSize="28" />
            <Entry x:Name="DescriptionEntry" Placeholder="Enter Description" WidthRequest="350" FontSize="28" />
            <Entry x:Name="FrequencyEntry" Placeholder="Enter Frequency" WidthRequest="350" FontSize="28" />
            <Button Text="Add Habit" FontSize="28" Pressed="AddHabit_Pressed"/>
        </FlexLayout>

    </Grid>
</ContentPage>