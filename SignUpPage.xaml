<ContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              x:Class="HabitTracker.SignUpPage"
              Title="Make or Break it!">
    <VerticalStackLayout>

        <Label
            Text="Sign up!"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1"
            Padding="45"
            FontSize="50"/>

        <Entry 
            x:Name="EmailInput"
            Placeholder="Enter your email"
            WidthRequest="500"
            FontSize="20"
            Margin="15"/>

        <Entry 
            x:Name="UserInput"
            Placeholder="Enter a username"
            WidthRequest="500"
            FontSize="20"
            Margin="15"/>

        <Entry 
            x:Name="PasswordInput"
            Placeholder="Enter a password"
            WidthRequest="500"
            FontSize="20"
            IsPassword="True"
            Margin="15"/>

        <Entry 
            x:Name="ConfirmPasswordInput"
            Placeholder="Confirm your password"
            WidthRequest="500"
            FontSize="20"
            IsPassword="True"
            Margin="15"/>

        <Button
            x:Name="SignUp"
            Text="Sign up" 
            SemanticProperties.Hint="Creates a new account"
            Clicked="OnSignUpClicked"
            HorizontalOptions="Fill" 
            MaximumWidthRequest="300"
            Margin="15"/>

    </VerticalStackLayout>
</ContentPage>
    
